# Token del bot de Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=ponga-el-token-aqui

# API key de Groq (https://console.groq.com/keys) - plan gratuito
GROQ_API_KEY=ponga-su-key-aqui

# Auto-update (opcionales)
GIT_REPO=https://github.com/sshsrv/sharkai.git
GIT_BRANCH=main
POLL_SECONDS=60
# Cooldown entre preguntas por usuario (segundos)
COOLDOWN_SECONDS=3
