# Token del bot de Discord (https://discord.com/developers/applications)
DISCORD_TOKEN=ponga-el-token-aqui

# API key de Groq (https://console.groq.com/keys) - plan gratuito
GROQ_API_KEY=ponga-su-key-aqui

# API key de Google AI Studio (https://aistudio.google.com/apikey) - plan gratuito
# Necesaria solo si quieres usar los modelos de Google (gemini-*)
GOOGLE_API_KEY=ponga-la-key-de-google-aqui

# Auto-update (opcionales)
GIT_REPO=https://github.com/sshsrv/sharkai.git
GIT_BRANCH=main
POLL_SECONDS=60
# Cooldown entre preguntas por usuario (segundos)
COOLDOWN_SECONDS=3
# Límite diario compartido entre todos los modelos (se muestra en /sh usage y el footer)
# SHARED_DAILY_LIMIT=1000